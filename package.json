{
  "name": "wizzy",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "homepage": "https://levgilboa.github.io/wizzy-web",
  "scripts": {
    "start": "npx expo start",
    "start:groq": "dotenv -e .env -- npx expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "npx expo export -p web",
    "predeploy:gh": "npm run build:web",
    "deploy:gh": "npm run predeploy:gh && node -e \"require('fs').writeFileSync('dist/.nojekyll', '')\" && gh-pages -d dist -t true",
    "preview": "npx expo export -p web && npx serve dist",
    "server": "npm start --prefix server",
    "test": "jest --watchAll",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1004.0",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "expo": "~52.0.7",
    "expo-av": "~15.0.1",
    "expo-blur": "~14.0.1",
    "expo-constants": "~17.0.3",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.1",
    "expo-haptics": "~14.0.0",
    "expo-image-picker": "~16.0.3",
    "expo-linear-gradient": "^14.0.1",
    "expo-linking": "~7.0.2",
    "expo-router": "~4.0.6",
    "expo-splash-screen": "~0.29.11",
    "expo-status-bar": "~2.0.0",
    "expo-symbols": "~0.2.0",
    "expo-system-ui": "~4.0.3",
    "expo-web-browser": "~14.0.1",
    "firebase": "^11.1.0",
    "mammoth": "^1.8.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.2",
    "react-native-animatable": "^1.4.0",
    "react-native-circular-progress": "^1.4.1",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-pdf": "^6.7.5",
    "react-native-pdf-lib": "^1.0.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-screens": "~4.1.0",
    "react-native-svg": "^15.10.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^25.2.1",
    "@types/react": "~18.3.12",
    "@types/react-native": "^0.72.8",
    "@types/react-test-renderer": "^18.3.0",
    "dotenv-cli": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "gh-pages": "^6.3.0",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.2",
    "prettier": "^3.4.2",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3"
  },
  "private": true
}